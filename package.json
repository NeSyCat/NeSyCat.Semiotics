{
  "name": "semiotics.nesycat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "bash scripts/vercel-prebuild.sh && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:authed:setup": "npx tsx _tests/e2e-authed/scripts/setup.ts",
    "test:e2e:authed": "npm run test:e2e:authed:setup && E2E_AUTHED=1 PLAYWRIGHT_SKIP_WEBSERVER=1 playwright test --project=authed-setup --project=authed-chromium",
    "test:e2e:authed:ui": "npm run test:e2e:authed:setup && E2E_AUTHED=1 PLAYWRIGHT_SKIP_WEBSERVER=1 playwright test --project=authed-setup --project=authed-chromium --ui",
    "p8:emit": "prisma contract emit --config prisma/prisma.config.ts",
    "p8:verify": "prisma db verify --config prisma/prisma.config.ts",
    "p8:update:dry": "prisma db update --dry-run --config prisma/prisma.config.ts",
    "p8:update": "prisma db update -y --advance-ref db --config prisma/prisma.config.ts"
  },
  "dependencies": {
    "@getbrevo/brevo": "6.0.3",
    "@prisma/orm-postgres": "8.0.0-rc.3",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.104.0",
    "@types/katex": "^0.16.8",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@xyflow/react": "^12.10.2",
    "admination-design-system": "file:./vendor/Admination.02-Design/0-foundations/admination-design-system",
    "clsx": "^2.1.1",
    "katex": "^0.17.0",
    "next": "16.2.4",
    "pg": "8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prisma": "8.0.0-rc.5",
    "supabase": "^2.93.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
