// use prisma-next
//
// SOURCE OF TRUTH: this file is the doctrine — it is the schema. Tables,
// columns, RLS, and the 11 policies below are DERIVED from this contract by
// `prisma contract emit` (offline) and applied to Postgres by `prisma db
// init` (fresh DB) or `prisma db update` (existing DB — see prisma/README.md
// for the full pipeline and why there is no migration-graph step).
//
// Functions/triggers referenced by the policies below (my_member_organizations,
// my_owner_organizations, organization_has_no_members, prevent_orphan_organization)
// are INVISIBLE to this contract — they live in prisma/sql/ and are applied by
// CI before `db init`/`db update` runs. See prisma/README.md.
//
// IDENTICAL NAMES DOCTRINE: models and fields below use the database's
// verbatim table/column names (lowercase snake_case) with NO @map/@@map — the
// live names already were canonical, so the code side adopted them instead of
// re-mapping. Sandbox-proven (p8-spike-pg, 2026-08-18) via `db update
// --dry-run`: dropping @id/@relation/@@unique's `map:` and every model/field
// @map/@@map produces ZERO operations (their PSL-default wire names already
// equal the live names) — see .foreman/scratch/design-prisma8-v3.md for the
// spike this builds on. Policy blocks are the ONE exception: `@@map` stays on
// all 11 policies below — the sandbox proved dropping it makes `contract
// emit` synthesize a wire-name hash suffix, and `db update` then plans an
// `ALTER POLICY ... RENAME TO "<name>_<hash>"` for every one of them. That's
// real DDL for no naming benefit (policy names are invisible to app code), so
// the maps stay and drift detection remains in force for them.
//
// DRIFT CHECK IS BYTE-FOR-BYTE: `contract emit` compares each adopted policy's
// authored predicate text against Postgres's reprinted form byte-for-byte
// (PN_EXACT_NAME_BODY_COMPARISON). Do not reformat, re-wrap, or "clean up"
// a policy's `using`/`withCheck` string, and do not remove a policy's
// `@@map` — doing so breaks drift detection against the adopted production
// database. Edit with care.
//
// Base: inferred verbatim from the prod-replica via `prisma-next contract
// infer --db` during the Prisma 8 adoption spike (2026-08-18); see
// .foreman/scratch/design-prisma8-v3.md for the spike writeup.
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

namespace public {
  model organizations {
    id          Uuid          @id @default(dbgenerated("gen_random_uuid()"))
    name        String
    created_at  Timestamptz   @default(now())
    updated_at  Timestamptz   @default(now())
    diagrams    diagrams[]
    memberships memberships[]

    @@rls
  }

  model diagrams {
    id              Uuid          @id @default(dbgenerated("gen_random_uuid()"))
    title           String
    data            Jsonb
    created_at      Timestamptz   @default(now())
    updated_at      Timestamptz   @default(now())
    organization_id Uuid
    organization    organizations @relation(fields: [organization_id], references: [id], index: false)

    @@rls
  }

  model memberships {
    id              Uuid          @id @default(dbgenerated("gen_random_uuid()"))
    user_id         Uuid
    organization_id Uuid
    is_owner        Boolean       @default(false)
    created_at      Timestamptz   @default(now())
    updated_at      Timestamptz   @default(now())
    organization    organizations @relation(fields: [organization_id], references: [id], index: false)

    @@unique([user_id, organization_id])
    @@rls
  }

  policy_all diagrams_member_all {
    target = diagrams
    roles = [authenticated]
    using = "(organization_id IN ( SELECT my_member_organizations() AS my_member_organizations))"
    withCheck = "(organization_id IN ( SELECT my_member_organizations() AS my_member_organizations))"
    @@map("diagrams_member_all")
  }

  policy_delete memberships_delete_owner {
    target = memberships
    roles = [authenticated]
    using = "(organization_id IN ( SELECT my_owner_organizations() AS my_owner_organizations))"
    @@map("memberships_delete_owner")
  }

  policy_insert memberships_insert_bootstrap {
    target = memberships
    roles = [authenticated]
    withCheck = "((user_id = ( SELECT auth.uid() AS uid)) AND (is_owner = true) AND organization_has_no_members(organization_id))"
    @@map("memberships_insert_bootstrap")
  }

  policy_insert memberships_insert_owner {
    target = memberships
    roles = [authenticated]
    withCheck = "(organization_id IN ( SELECT my_owner_organizations() AS my_owner_organizations))"
    @@map("memberships_insert_owner")
  }

  policy_select memberships_select_member {
    target = memberships
    roles = [authenticated]
    using = "(organization_id IN ( SELECT my_member_organizations() AS my_member_organizations))"
    @@map("memberships_select_member")
  }

  policy_select memberships_select_self {
    target = memberships
    roles = [authenticated]
    using = "(user_id = ( SELECT auth.uid() AS uid))"
    @@map("memberships_select_self")
  }

  policy_update memberships_update_owner {
    target = memberships
    roles = [authenticated]
    using = "(organization_id IN ( SELECT my_owner_organizations() AS my_owner_organizations))"
    withCheck = "(organization_id IN ( SELECT my_owner_organizations() AS my_owner_organizations))"
    @@map("memberships_update_owner")
  }

  policy_delete organizations_delete_owner {
    target = organizations
    roles = [authenticated]
    using = "(id IN ( SELECT my_owner_organizations() AS my_owner_organizations))"
    @@map("organizations_delete_owner")
  }

  policy_insert organizations_insert_auth {
    target = organizations
    roles = [authenticated]
    withCheck = "true"
    @@map("organizations_insert_auth")
  }

  policy_select organizations_select_member {
    target = organizations
    roles = [authenticated]
    using = "(id IN ( SELECT my_member_organizations() AS my_member_organizations))"
    @@map("organizations_select_member")
  }

  policy_update organizations_update_owner {
    target = organizations
    roles = [authenticated]
    using = "(id IN ( SELECT my_owner_organizations() AS my_owner_organizations))"
    withCheck = "(id IN ( SELECT my_owner_organizations() AS my_owner_organizations))"
    @@map("organizations_update_owner")
  }
}
